{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/cases",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/torres",
      "destination": "/telecomunicacoes",
      "permanent": true
    },
    {
      "source": "/telecom",
      "destination": "/telecomunicacoes",
      "permanent": true
    },
    {
      "source": "/torres-telecom",
      "destination": "/telecomunicacoes",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/quem-somos",
      "permanent": true
    },
    {
      "source": "/sobre-nos",
      "destination": "/quem-somos",
      "permanent": true
    },
    {
      "source": "/obras",
      "destination": "/construtora",
      "permanent": true
    },
    {
      "source": "/projetos",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|svg|ico|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
